# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# MongoDB Connection - Replace with your actual connection string from MongoDB Atlas
# For Atlas: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/sollarity?retryWrites=true&w=majority
# For Local: mongodb://localhost:27017/sollarity
# For Docker: mongodb://sollarity:sollarity123@mongodb:27017/sollarity
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/sollarity?retryWrites=true&w=majority

# API Keys
BIRDEYE_API_KEY=your_birdeye_api_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_URL=https://price.jup.ag/v4

# PayPal Configuration (replace Stripe)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_MODE=sandbox

# Security
JWT_SECRET=your_jwt_secret_key_here
SESSION_SECRET=your_session_secret_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Data Pipeline Configuration
SCRAPER_INTERVAL_MINUTES=15
ANALYZER_INTERVAL_MINUTES=30
MAX_COINS_PER_SCRAPE=100
DAYS_OF_HISTORY=7

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Redis (optional, for caching)
REDIS_URL=redis://localhost:6379

# Email Configuration (optional, for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Monitoring (optional)
SENTRY_DSN=your_sentry_dsn
NEW_RELIC_LICENSE_KEY=your_new_relic_key